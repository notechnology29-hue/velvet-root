# Copy to .env.local and fill in. Never put real values in this file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API). Rotate if ever exposed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=The VLVT Root Admin
ADMIN_PASSCODE=generate-a-long-random-value

# Member portal
PORTAL_PASSWORD=generate-a-long-random-value

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Webhooks
RSVP_WEBHOOK_URL=https://example.com/api/rsvp-intake
MEMBERSHIP_WEBHOOK_URL=https://example.com/api/membership-intake

# Link-only pitch pages (generate each with: openssl rand -hex 24)
PITCH_SPONSORS_TOKEN=generate-with-openssl
PITCH_DISPENSARY_TOKEN=generate-with-openssl
